{
  "schema_version": 1,
  "policy_id": "twin_bays_value_scoped_validation_v1",
  "principles": {
    "targeted_before_full": true,
    "reuse_unchanged_evidence": true,
    "environment_failure_is_not_product_failure": true,
    "golden_is_release_only": true
  },
  "change_scopes": {
    "reference_or_docs": ["reference_contract"],
    "visual_only": ["reference_contract", "rendered_captures", "human_visual_review"],
    "layout_or_collision": ["structure", "collision", "portal", "rendered_captures"],
    "gameplay_or_routing": ["runtime", "map_routes", "shared_profile"],
    "ai": ["runtime", "ai_batch"],
    "rendering_or_assets": ["rendered_captures", "performance"],
    "release_candidate": ["all"]
  },
  "expensive_gates": {
    "ai_batch": {
      "estimated_seconds": 240,
      "run_only_when_relevant": true
    },
    "performance": {
      "estimated_seconds": 210,
      "run_only_when_relevant": true,
      "environment_failures_require_diagnosis_before_retry": true
    },
    "full_release": {
      "requires_explicit_release_candidate": true,
      "requires_reason": true,
      "maximum_consecutive_failed_attempts_per_fingerprint": 2,
      "override_requires_reason": true
    }
  }
}
