;; ================================================================
;;  参考图复刻 v3 — 一整块大陆被裂隙切割
;;
;;  核心理念：4块大面积平台重叠形成连贯的 L/C 形主大陆
;;  NE/SW/SE 通过窄桥连接
;;
;;  俯视示意：
;;       TTTTTTTTTTTTTTTT
;;  LLLL TTTTTTTTTTTTTTTT
;;  LLLL    CCCCCCCCCCCCCCCCCC
;;  LLLL    CCCCCCCCCCCCCCCCCC    NNNNNNNN
;;  LLLL    CCCCCCCCCCCCCCCCCC====NNNNNNNN
;;  LLLL====CCCCCCCCCCCCCCCCCC    NNNNNNNN
;;          CCCCCCCCCCCCCCCCCC
;;          CCCCCCCCCCCCCCCCCC
;;              ||        ||
;;           SSSSSSS   EEEEEEE
;;           SSSSSSS   EEEEEEE
;;           SSSSSSS   EEEEEEE
;;
;;  L=左臂  T=顶臂  C=中央  N=NE岛  S=SW岛  E=SE岛
;;  ==宽连接  ||窄桥
;; ================================================================

;; ==================== 主大陆：NW 顶部横杆（参考图上方主平台） ====================
[node name="NW_Bar_Base" type="CSGBox3D" parent="Terrain"]
transform = Transform3D(1, 0, 0, 0, 1, 0, 0, 0, 1, -28, -2, -42)
use_collision = true
size = Vector3(46, 4, 18)
material = SubResource("mat_cliff")

[node name="NW_Bar_Grass" type="CSGBox3D" parent="Terrain"]
transform = Transform3D(1, 0, 0, 0, 1, 0, 0, 0, 1, -28, 0.1, -42)
use_collision = true
size = Vector3(46, 0.2, 18)
material = SubResource("mat_grass")

