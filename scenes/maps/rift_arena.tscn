;; ================================================================
;;  地图布局（俯视）—— 不规则大陆 + 裂隙切入
;;
;;  参考图分析：一整块有机形状的大陆地，被几条裂隙从边缘切入，
;;  形成蜿蜒的走廊和开阔的战斗区域。不是对称的，不是离散岛屿。
;;
;;  设计原则：用大块重叠平台拼接，走廊部分较窄（12-18单位），
;;  战斗区域宽阔（40-50单位），裂隙是"没有几何体的空白区域"。
;;
;;     ┌─────── 北区 ────────────┐
;;     │                          ├─ NE区
;;     │         ┌裂隙┐          │
;;     ├走廊┤ ╳  ├走廊┤
;;   西区   │         │        东区
;;     │    └裂隙┘    │          │
;;     ├走廊┤    ├走廊┤
;;     │         ╳裂隙╳          │
;;   SW区   │     南区     │  SE区
;;     └────┴─────────────┴─────┘
;;
;;  ╳ = 裂隙交叉点（无地面，可坠落）
;; ================================================================

[node name="Terrain" type="Node3D" parent="."]

;; ==================== 主要区域 ====================

;; 北区 —— 大型作战平台（偏左）
[node name="Area_North" type="CSGBox3D" parent="Terrain"]
transform = Transform3D(1, 0, 0, 0, 1, 0, 0, 0, 1, -20, -0.5, -45)
use_collision = true
size = Vector3(90, 1, 45)
material = SubResource("mat_grass")

;; 东北区 —— 中型平台
[node name="Area_NE" type="CSGBox3D" parent="Terrain"]
transform = Transform3D(1, 0, 0, 0, 1, 0, 0, 0, 1, 55, -0.5, -30)
use_collision = true
size = Vector3(45, 1, 40)
material = SubResource("mat_grass")

;; 东北高台
[node name="Area_NE_HighGround" type="CSGBox3D" parent="Terrain"]
transform = Transform3D(1, 0, 0, 0, 1, 0, 0, 0, 1, 60, 0.5, -35)
use_collision = true
size = Vector3(16, 2, 16)
material = SubResource("mat_stone")

;; 中央区 —— 核心交战区
[node name="Area_Center" type="CSGBox3D" parent="Terrain"]
transform = Transform3D(1, 0, 0, 0, 1, 0, 0, 0, 1, 0, -0.5, 0)
use_collision = true
size = Vector3(45, 1, 40)
material = SubResource("mat_grass")

;; 中央塔台
[node name="Area_Center_Tower" type="CSGBox3D" parent="Terrain"]
transform = Transform3D(1, 0, 0, 0, 1, 0, 0, 0, 1, 0, 1, 0)
use_collision = true
size = Vector3(14, 3, 14)
material = SubResource("mat_stone")

;; 西区 —— 狭长的西侧通道
[node name="Area_West" type="CSGBox3D" parent="Terrain"]
transform = Transform3D(1, 0, 0, 0, 1, 0, 0, 0, 1, -55, -0.5, 0)
use_collision = true
size = Vector3(35, 1, 35)
material = SubResource("mat_grass")

;; 东区 —— 东侧开阔区
[node name="Area_East" type="CSGBox3D" parent="Terrain"]
transform = Transform3D(1, 0, 0, 0, 1, 0, 0, 0, 1, 55, -0.5, 14)
use_collision = true
size = Vector3(40, 1, 44)
material = SubResource("mat_grass")

;; 东区台阶
[node name="Area_East_Step" type="CSGBox3D" parent="Terrain"]
transform = Transform3D(1, 0, 0, 0, 1, 0, 0, 0, 1, 65, 0, 25)
use_collision = true
size = Vector3(14, 1, 14)
material = SubResource("mat_stone")

;; 西南区
[node name="Area_SW" type="CSGBox3D" parent="Terrain"]
transform = Transform3D(1, 0, 0, 0, 1, 0, 0, 0, 1, -55, -0.5, 40)
use_collision = true
size = Vector3(40, 1, 30)
material = SubResource("mat_grass")

;; 南区 —— 南侧大平台
[node name="Area_South" type="CSGBox3D" parent="Terrain"]
transform = Transform3D(1, 0, 0, 0, 1, 0, 0, 0, 1, 0, -0.5, 50)
use_collision = true
size = Vector3(75, 1, 35)
material = SubResource("mat_grass")

;; 东南区
[node name="Area_SE" type="CSGBox3D" parent="Terrain"]
transform = Transform3D(1, 0, 0, 0, 1, 0, 0, 0, 1, 50, -0.5, 50)
use_collision = true
size = Vector3(40, 1, 30)
material = SubResource("mat_grass")

;; SE高台
[node name="Area_SE_HighGround" type="CSGBox3D" parent="Terrain"]
transform = Transform3D(1, 0, 0, 0, 1, 0, 0, 0, 1, 58, 0.5, 52)
use_collision = true
size = Vector3(14, 2, 12)
material = SubResource("mat_stone")

;; ==================== 走廊（连接区域，确保无断点） ====================
;; 每条走廊两端都与相邻区域重叠至少5单位

;; C1: 北区 → 中央（裂隙两侧的通道）
[node name="Corridor_North_to_Center" type="CSGBox3D" parent="Terrain"]
transform = Transform3D(1, 0, 0, 0, 1, 0, 0, 0, 1, -5, -0.5, -17)
use_collision = true
size = Vector3(20, 1, 18)
material = SubResource("mat_path")

;; C2: 北区 → 东北
[node name="Corridor_North_to_NE" type="CSGBox3D" parent="Terrain"]
transform = Transform3D(1, 0, 0, 0, 1, 0, 0, 0, 1, 28, -0.5, -38)
use_collision = true
size = Vector3(16, 1, 20)
material = SubResource("mat_path")

;; C3: 中央 → 西区
[node name="Corridor_Center_to_West" type="CSGBox3D" parent="Terrain"]
transform = Transform3D(1, 0, 0, 0, 1, 0, 0, 0, 1, -31, -0.5, 0)
use_collision = true
size = Vector3(20, 1, 14)
material = SubResource("mat_path")

;; C4: 中央 → 东区
[node name="Corridor_Center_to_East" type="CSGBox3D" parent="Terrain"]
transform = Transform3D(1, 0, 0, 0, 1, 0, 0, 0, 1, 30, -0.5, 5)
use_collision = true
size = Vector3(18, 1, 14)
material = SubResource("mat_path")

;; C5: 中央 → 南区 / 西南区（偏左通道）
[node name="Corridor_Center_to_South" type="CSGBox3D" parent="Terrain"]
transform = Transform3D(1, 0, 0, 0, 1, 0, 0, 0, 1, -10, -0.5, 27)
use_collision = true
size = Vector3(16, 1, 20)
material = SubResource("mat_path")

;; C6: 西区 → 西南区
[node name="Corridor_West_to_SW" type="CSGBox3D" parent="Terrain"]
transform = Transform3D(1, 0, 0, 0, 1, 0, 0, 0, 1, -55, -0.5, 21)
use_collision = true
size = Vector3(14, 1, 16)
material = SubResource("mat_path")

;; C7: 东区 → 南区/东南
[node name="Corridor_East_to_South" type="CSGBox3D" parent="Terrain"]
transform = Transform3D(1, 0, 0, 0, 1, 0, 0, 0, 1, 35, -0.5, 34)
use_collision = true
size = Vector3(14, 1, 14)
material = SubResource("mat_path")

;; C8: 东北 → 东区
[node name="Corridor_NE_to_East" type="CSGBox3D" parent="Terrain"]
transform = Transform3D(1, 0, 0, 0, 1, 0, 0, 0, 1, 55, -0.5, -6)
use_collision = true
size = Vector3(14, 1, 12)
material = SubResource("mat_path")

;; C9: 西南 → 南区
[node name="Corridor_SW_to_South" type="CSGBox3D" parent="Terrain"]
transform = Transform3D(1, 0, 0, 0, 1, 0, 0, 0, 1, -32, -0.5, 43)
use_collision = true
size = Vector3(14, 1, 14)
material = SubResource("mat_path")

;; C10: 北区 → 西区（西北通道）
[node name="Corridor_North_to_West" type="CSGBox3D" parent="Terrain"]
transform = Transform3D(1, 0, 0, 0, 1, 0, 0, 0, 1, -50, -0.5, -17)
use_collision = true
size = Vector3(14, 1, 22)
material = SubResource("mat_path")

[node name="WeaponSpawner" type="Node" parent="."]
